{
  "fixture_base": "repo",
  "tz": "America/Chicago",
  "description": "Robin opens a planning session with a brief. The first reply puts the plan page up: an HTML file in the plan dir (the block names no pages dir), in the fixed theme and section numbers, the architecture as real structure, every choice a row marked proposed with its options and the recommended one, nothing shown as decided, and no question asked before the page exists. The decision asked is three or four real options (fewer only when fewer exist, and the page and reply say so), one marked recommended, then `Recommend: <option>, because <reason>.`, then `Which option for <id>?` as the last line; never a yes or no on one proposal.",
  "prompt": "We are planning the architecture for the export feature. The brief is docs/export-brief.md. This is a planning session.",
  "peers": "sessions.json",
  "graders": [
    {
      "name": "one plan page written",
      "type": "published",
      "min": 1,
      "max": 1,
      "content_match": [
        "(?i)\\A<!doctype html>\\s*<meta charset=\"utf-8\">",
        "--designed:\\s*#2c58a0",
        "padding-inline:\\s*20px",
        "<section id=\"s1\">\\s*<h2>1\\. Decided</h2>",
        "<section id=\"s2\">\\s*<h2>2\\. Open</h2>",
        "<section id=\"s3\">\\s*<h2>3\\. Structure</h2>",
        "<section id=\"s4\">\\s*<h2>4\\. What the brief asks for</h2>",
        "<section id=\"s5\">\\s*<h2>5\\. Files</h2>",
        "class=\"eyebrow\">Plan · turn 1\\b",
        "<b>Open</b> \\d+"
      ]
    },
    {
      "name": "every choice is a row marked proposed, with its basis",
      "type": "published",
      "content_match": [
        "<td class=\"id\">[A-Z]+\\d+</td>",
        "class=\"pill open\">proposed<",
        "<th>Basis</th>",
        "Read in ",
        "Not read",
        "<th>Options</th>",
        "<th>Recommended</th>"
      ],
      "content_not_match": [
        "class=\"pill done\">decided<"
      ]
    },
    {
      "name": "the plan is the architecture, as real structure",
      "type": "published",
      "content_match": [
        "(session_id|data|event)\\s*:\\s*(str|dict)",
        "store\\.py",
        "queue\\.py",
        "R1",
        "R2",
        "R3",
        "export-brief\\.md"
      ]
    },
    {
      "name": "nothing new outside the plan dir and the architecture dir",
      "type": "no_new_files",
      "except": [
        "plans/**",
        "architecture/**"
      ]
    },
    {
      "name": "no question before the page",
      "type": "tool_used",
      "tool": "AskUserQuestion",
      "max": 0
    },
    {
      "name": "reply gives the file path",
      "type": "regex",
      "pattern": "plans/[\\w.-]+-plan\\.html"
    },
    {
      "name": "reply points at rows by id",
      "type": "regex",
      "pattern": "\\b[A-Z]+\\d+\\b"
    },
    {
      "name": "reply carries one recommendation line",
      "type": "regex",
      "pattern": "(?m)^\\**Recommend:\\**\\s+\\S"
    },
    {
      "name": "the page opens on one next decision, readable cold",
      "type": "published",
      "content_match": [
        "<section id=\"next\" class=\"next\">\\s*<h2>Next decision: [A-Z]+\\d+, \\S",
        "<b>The problem\\.</b>",
        "<b>The options\\.</b>",
        "(?s)<section id=\"next\" class=\"next\">(?:(?!</section>).)*<th>Option</th>(?:(?!</section>).)*<th>What it costs</th>(?:(?!</section>).)*<th>Basis</th>",
        "(?s)<section id=\"next\" class=\"next\">(?:(?!</section>).)*class=\"pill open\">recommended<",
        "<h3>Waiting behind it</h3>",
        "<th>The question</th>",
        "<b>What it does not decide\\.</b>",
        "(?s)<section id=\"next\".*<section id=\"s1\">"
      ],
      "content_not_match": [
        "(?s)id=\"next\".*id=\"next\""
      ]
    },
    {
      "name": "the page's next decision offers three or four options, or says why fewer",
      "type": "published",
      "content_match": [
        "(?s)<table class=\"options\">(?:(?!</table>).)*?<tbody>(?:\\s*<tr[^>]*>(?:(?!</tr>).)*</tr>){3,4}\\s*</tbody>|(?i:\\bonly (?:one|two) real options?\\b)"
      ]
    },
    {
      "name": "reply restates the one pending decision in full and ends on the ask",
      "type": "regex",
      "pattern": "(?s)\\A(?!.*Which option for.*Which option for).*Next decision:?\\**\\s*\\**`?(?P<id>[A-Z]+\\d+)`?\\**,? .*The problem.*The options.*Which option for \\W*(?P=id)\\W*\\?\\W*\\Z"
    },
    {
      "name": "the reply lays the options out as a table, one marked recommended",
      "type": "regex",
      "pattern": "(?s)(?i:^[ \\t]*\\|[ \\t]*\\**option\\**[ \\t]*\\|).*^[ \\t]*\\|[^\\n]*\\b[Rr]ecommended\\b"
    },
    {
      "name": "the reply offers three or four options, or says why fewer",
      "type": "regex",
      "pattern": "(?:^[ \\t]*\\|[ \\t]*\\**Option\\**[ \\t]*\\|[^\\n]*\\n[ \\t]*\\|[ \\t:|-]+\\|[ \\t]*\\n(?:[ \\t]*\\|[^\\n]*\\|[ \\t]*\\n){3,4}(?![ \\t]*\\n?[ \\t]*\\|))|(?i:\\bonly (?:one|two) real options?\\b)"
    },
    {
      "name": "the recommendation names an option and a reason, not an order of settling",
      "type": "regex",
      "pattern": "(?m)^\\W*Recommend:\\W*(?!settle\\b)\\S[^\\n]*\\bbecause\\b"
    },
    {
      "name": "the reply asks no yes or no",
      "type": "regex",
      "pattern": "Do you approve",
      "match": "absent"
    },
    {
      "name": "canonical document untouched",
      "type": "file_unchanged",
      "path": "docs/ARCHITECTURE.md"
    },
    {
      "name": "code untouched",
      "type": "file_unchanged",
      "path": "src/app/store.py"
    },
    {
      "name": "no relay",
      "type": "peer_calls",
      "tool": "send",
      "max": 0
    },
    {
      "name": "nothing written is hard-wrapped or width-capped",
      "type": "flowing_text"
    }
  ],
  "max_turns": 40,
  "timeout_seconds": 900
}
